\renewcommand{\printpartname}{}
\renewcommand{\printpartnum}{}
\renewcommand{\printparttitle}[1]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north east,rotate=90,inner sep=0pt,
      font=\fontsize{36}{40}\selectfont\bfseries]
      (part) at ([xshift=0.5in,yshift=-0.5in]current page.north west)
      {\partname\ \thepart};
    \draw[line width=5pt] ([xshift=7.5pt]part.base west) --
      ([xshift=7.5pt]part.base east);
    \node[right=12.5pt of part.base east,anchor=north west,
      text width=5.6in,align=left,font=\Huge\bfseries] {#1};
  \end{tikzpicture}%
}
\aliaspagestyle{part}{empty}

\newif\ifnumberedchap
\makechapterstyle{cetzframed}{%
  \chapterstyle{article}
  \renewcommand{\printchapternum}{\global\numberedchaptrue}
  \renewcommand{\printchapternonum}{\global\numberedchapfalse}
  \renewcommand{\printchaptertitle}[1]{%
    \begin{tikzpicture}
      \node[draw,inner xsep=0pt,inner ysep=\baselineskip,
        text width=\dimexpr\linewidth-2\fboxrule\relax,
        align=center,font=\chapnamefont] (title) {##1};
      \ifnumberedchap
        \node[fill=white,anchor=west,inner xsep=0.5em,inner ysep=0pt,
          font=\footnotesize\scshape] at ([xshift=1ex]title.north west)
          {Chapter \oldstylenums{\thechapter}};
      \fi
    \end{tikzpicture}%
  }
}
