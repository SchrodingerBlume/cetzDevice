library(cetzDevice)
build_figures <- isTRUE(getOption("cetzDevice.build_figures"))
knitr::opts_knit$set(root.dir = normalizePath("figures"))
knitr::opts_chunk$set(eval = build_figures, echo = TRUE, results = "hide",
                     message = FALSE, warning = FALSE, comment = NA)
knitr::knit_hooks$set(chunk = function(x, options) x, source = function(x, options) {
  lines <- sum(lengths(strsplit(x, "\n", fixed = TRUE)))
  paste0("\\needspace{", lines + 3L, "\\baselineskip}\n\\begin{rcode}\n",
         paste(x, collapse = "\n"), "\n\\end{rcode}\n")
})
@

