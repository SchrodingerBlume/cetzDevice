<<normal-figure,include=FALSE>>=
cetz("normal.typ", width = 4.5, height = 3.5,
     family = "Libertinus Serif", pointsize = 11)
x <- seq(-4, 4, length.out = 200)
plot(x, dnorm(x), type = "l", col = "blue", lwd = 1.5,
     xlab = cetz_typst("$x$"), ylab = cetz_typst("$p(x)$"),
     main = cetz_typst("$p(x) = 1 / sqrt(2 pi) e^(-x^2/2)$"))
xi <- seq(-2, 2, length.out = 25)
lines(xi, dnorm(xi), type = "h", col = "gray50")
lines(xi, dnorm(xi), type = "s")
text(2.2, 0.3, cetz_typst("$integral_(-2)^2 p(x) dif x approx 0.954$"),
     cex = 0.8)
dev.off()
@

<<render-figures,include=FALSE,purl=FALSE>>=
for (name in c("normal", "default", "standalone", "preamble", "math",
               "annotations", "grid", "plotmath", "ggplot", "raster",
               "gradient", "page-001", "page-002")) {
  source <- paste0(name, "-wrapper.typ")
  writeLines(c(sprintf('#import "%s.typ": r-figure', name),
               '#set page(width: auto, height: auto, margin: 0pt, fill: white)',
               '#r-figure()'), source)
  status <- system2(Sys.which("typst"),
    c("compile", shQuote(source), shQuote(paste0(name, ".pdf"))))
  if (status != 0L) stop("Cannot compile manual figure: ", name)
}
@
\end{document}
